{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalizationConfig": {
    "DefaultCulture": "tr-TR",
    "SupportedCultures": [ "tr-TR", "en-US" ],
    "DefaultFields": [
      "ResponseValue.Message",
      "Response.Texts.UserMessage"
    ]
  }
}
